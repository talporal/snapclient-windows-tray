<Window x:Class="Sendspin.Windows.Tray.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sendspin · Windows speaker" Width="640" Height="650" MinWidth="540" MinHeight="560" Background="#111A21" WindowStartupLocation="CenterScreen">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="26">
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SENDSPIN" Foreground="#67E8D1" FontSize="12" FontWeight="Bold"/><TextBlock Text="Windows speaker" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel><Image x:Name="AppImage" Width="48" Height="48" Grid.Column="1"/></Grid>
<Border Background="#1D2A33" CornerRadius="12" Padding="16" Margin="0,18,0,16"><StackPanel><TextBlock x:Name="Status" Text="Connecting to the Windows service…" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock x:Name="Stats" Foreground="#94A8B6" Margin="0,5,0,0"/></StackPanel></Border>
<Border Background="#19242D" CornerRadius="12" Padding="18"><StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Server" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ServerInfo" Text="Loading server…" Foreground="#94A8B6" TextWrapping="Wrap" Margin="0,6,12,0"/></StackPanel><Button Content="&#xE713;" FontFamily="Segoe Fluent Icons" Grid.Column="1" Click="ToggleServerSettings" ToolTip="Server settings" AutomationProperties.Name="Server settings" Margin="0"/></Grid>
<StackPanel x:Name="ServerSettings" Visibility="Collapsed" Margin="0,18,0,0">
<TextBlock Text="Discovered Sendspin servers"/><ComboBox x:Name="Servers" SelectionChanged="ChooseServer"/>
<WrapPanel Margin="0,0,0,14"><Button Content="Refresh discovery" Click="Discover"/><Button Content="Automatic selection" Click="AutoSelect"/></WrapPanel>
<TextBlock Text="Address"/><TextBox x:Name="Host" ToolTip="Leave blank to use the only discovered server automatically."/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Port"/><TextBox x:Name="Port" Text="8927"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="WebSocket path"/><TextBox x:Name="Endpoint" Text="/sendspin"/></StackPanel></Grid>
<TextBlock Text="Player name"/><TextBox x:Name="PlayerName"/>
<CheckBox x:Name="EnableDiscovery" Content="Discover servers on the local network" IsChecked="True"/>
<CheckBox x:Name="Enabled" Content="Enable playback and reconnect automatically" IsChecked="True"/>
<TextBlock Text="When enabled, the service connects and retries after a disconnect. Disable to pause playback; the Windows service stays running. The tray does not need to stay open." Foreground="#94A8B6" TextWrapping="Wrap" Margin="0,8,0,14"/>
<Button Content="Save server settings" Click="Save" Tag="server" HorizontalAlignment="Left" Background="#67E8D1" Foreground="#10251F"/>
</StackPanel></StackPanel></Border>
<Border Background="#19242D" CornerRadius="12" Padding="18" Margin="0,14,0,0"><StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Audio output" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="OutputInfo" Text="Loading service output…" Foreground="#94A8B6" TextWrapping="Wrap" Margin="0,6,12,0"/></StackPanel><Button Content="&#xE713;" FontFamily="Segoe Fluent Icons" Grid.Column="1" Click="ToggleAudioSettings" ToolTip="Audio settings" AutomationProperties.Name="Audio settings" Margin="0"/></Grid>
<StackPanel x:Name="AudioSettings" Visibility="Collapsed" Margin="0,18,0,0">
<TextBlock Text="Outputs visible to the Windows service"/><ComboBox x:Name="Devices"/>
<TextBlock x:Name="DeviceSummary" Text="Requesting service outputs…" Foreground="#94A8B6" TextWrapping="Wrap" Margin="0,0,0,8"/>
<WrapPanel><Button Content="Refresh devices" Click="RefreshDevices"/><Button Content="Test speakers" Click="TestSpeakers"/></WrapPanel>
<Expander Header="Service output list"><TextBox x:Name="ServiceOutputs" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="180" VerticalScrollBarVisibility="Auto"/></Expander>
<Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Output buffer (20–500 ms)"/><TextBox x:Name="OutputBuffer" Text="100"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Network buffer (50–2000 ms)"/><TextBox x:Name="NetworkBuffer" Text="150"/></StackPanel></Grid>
<Button Content="Save audio settings" Click="Save" Tag="audio" HorizontalAlignment="Left" Background="#67E8D1" Foreground="#10251F"/>
</StackPanel>
<Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Volume"/><TextBlock x:Name="VolumePercent" Text="75%" Grid.Column="1" Foreground="#67E8D1"/></Grid>
<Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><Slider x:Name="Volume" Minimum="0" Maximum="100" Value="75" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="VolumeChanged" Margin="0,8,16,8"/><CheckBox x:Name="Mute" Grid.Column="1" Content="Mute" VerticalAlignment="Center" Checked="MuteChanged" Unchecked="MuteChanged" Margin="0"/></Grid>
</StackPanel></Border>
<WrapPanel Margin="0,18,0,0"><Button Content="Diagnostics" Click="ToggleDiagnostics"/><Button Content="Hide to tray" Click="Hide"/></WrapPanel>
<StackPanel x:Name="DiagnosticsPanel" Visibility="Collapsed" Margin="0,16,0,0"><TextBlock Text="Service diagnostics" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="DiagnosticStats" Foreground="#94A8B6" Margin="0,6,0,0"/><TextBox x:Name="Logs" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="220" VerticalScrollBarVisibility="Auto" Margin="0,12,0,12"/><Button Content="Restart service" Click="Restart" HorizontalAlignment="Left"/></StackPanel>
</StackPanel></ScrollViewer></Window>